<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.memphisreo</groupId>
    <artifactId>memphisreo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Memphisreo Parent</name>
    <description>Мультитенантна платформа нерухомості — модульний моноліт (docs/architecture.md)</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <totp.version>1.7.1</totp.version>
        <lombok.version>1.18.34</lombok.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <aws-sdk.version>2.53.2</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Явно новіше за версію, керовану Spring Boot 3.3.5 (1.19.8) —
                 стара несумісна з Docker Engine API сучасних версій Docker
                 Desktop. Імпорт ПЕРЕД spring-boot-dependencies — у Maven
                 перше оголошення для GA перемагає при мерджі dependencyManagement. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- S3-сумісний object storage (MinIO зараз, AWS S3 пізніше без
                 зміни коду) — docs/architecture.md §7. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AWS SDK BOM не керує голим httpclient5 (лише своїм apache5-client
                 модулем) — без цього перемагає версія 5.3.1 зі spring-boot-dependencies,
                 у якій ще немає TlsSocketStrategy (NoClassDefFoundError при
                 інстанціюванні S3Client). AWS SDK 2.53.2 очікує httpclient5 5.6.x,
                 який своєю чергою тягне httpcore5 5.4.3 — Spring Boot тримає
                 httpcore5 на 5.2.5 (NoSuchMethodError без цього пін'а). -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>5.6.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>5.4.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>5.4.3</version>
            </dependency>

            <!-- Модулі платформи (docs/architecture.md §2) -->
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>property</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>listing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>media</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>inquiry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>crm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.memphisreo</groupId>
                <artifactId>document</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- TOTP (RFC 6238) для 2FA — docs/security.md §5 -->
            <dependency>
                <groupId>dev.samstevens.totp</groupId>
                <artifactId>totp</artifactId>
                <version>${totp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>modules/common</module>
        <module>modules/security</module>
        <module>modules/tenant</module>
        <module>modules/agent</module>
        <module>modules/property</module>
        <module>modules/listing</module>
        <module>modules/media</module>
        <module>modules/search</module>
        <module>modules/inquiry</module>
        <module>modules/crm</module>
        <module>modules/document</module>
        <module>platform-app</module>
    </modules>
</project>
