<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.memphisreo</groupId>
        <artifactId>memphisreo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>platform-app</artifactId>
    <packaging>jar</packaging>
    <name>Memphisreo :: Platform App</name>
    <description>Єдиний деплоюваний артефакт модульного моноліта — docs/architecture.md §1</description>

    <dependencies>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>property</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>listing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>media</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>search</artifactId>
        </dependency>
        <dependency>
            <groupId>com.memphisreo</groupId>
            <artifactId>inquiry</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Без цього maven-failsafe-plugin тягне власний (старіший) junit-platform-launcher,
             несумісний з версією JUnit, якою керує Spring Boot BOM — "TestEngine failed to discover tests" -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Реальний Postgres+PostGIS у тестах — жоден з 7 багів, знайдених
             при живому прогоні, не спіймав би мокований/H2 тест. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>platform-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- Без classifier repackage ЗАМІНЮЄ основний артефакт
                                 модуля на fat jar (BOOT-INF/classes/... замість
                                 класів у корені) — Failsafe, будуючи classpath
                                 з артефакту після package-фази, не знаходить
                                 власні класи модуля (ClassNotFoundException).
                                 Класифікатор лишає плаский jar основним. -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- *IT класи (Testcontainers, потребують Docker) — на mvn verify,
                 окремо від швидких unit-тестів на mvn test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Auto-detected module-path ламає видимість класів
                         самого модуля у форкнутому процесі (NoClassDefFoundError
                         на власні класи) — примусово звичайний classpath. -->
                    <useModulePath>false</useModulePath>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
